# ============================================
# Robot Catty — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# cp .env.default .env
# ============================================

# --- Server ---
# Port for the web server (default: 3000)
WEB_PORT=3000

# --- Domain ---
# Public domain where the robot is accessible (e.g., catty.example.com)
# Leave empty if using direct IP only
SERVER_DOMAIN=your-domain.com

# WebSocket protocol: 'wss' for HTTPS domains, 'ws' for local/LAN
WS_PROTOCOL=wss

# --- Raspberry Pi ---
# IP address of the Raspberry Pi in the local network
PI_IP=192.168.1.100

# SSH password for deploying (if using sshpass)
# PI_PASS=your_ssh_password

# --- Serial Ports ---
# Arduino Uno (Head) — check with: ls /dev/ttyUSB*
UNO_PORT=/dev/ttyUSB0
UNO_BAUD=9600

# Arduino Mega (Body) — check with: ls /dev/ttyACM*
MEGA_PORT=/dev/ttyACM0
MEGA_BAUD=115200